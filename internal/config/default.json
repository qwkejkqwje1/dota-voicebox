{
  "version": 2,
  "devices": {
    "mic": "",
    "voice_out": "",
    "monitor": ""
  },
  "mic_gain": 1.0,
  "ducking": 0.35,
  "fx_on_sounds": false,
  "monitor_volume": 0.8,
  "sfx_volume": 1.0,
  "normalize_sounds": true,

  "ptt": {
    "key": "",
    "auto": true,
    "auto_detect": true,
    "lead_ms": 120,
    "tail_ms": 200
  },

  "talk": {
    "mode": "always",
    "key": "",
    "release_ms": 150,
    "press_game_key": true
  },

  "start_preset": "clean",
  "sounds_dir": "sounds",
  "tts_rate": 1,

  "sounds": {
    "siren":       { "label": "🚨 Мид ганкают", "files": ["builtin:siren"], "bus": "both", "cooldown": 3, "mode": "interrupt", "volume": 0.9 },
    "wisdom_rune": { "files": ["builtin:wisdom_rune"], "bus": "monitor", "mode": "ignore" },
    "mid_rune_6":  { "files": ["builtin:mid_rune_6"], "bus": "monitor", "mode": "ignore" },
    "power_rune":  { "files": ["builtin:power_rune"], "bus": "monitor", "mode": "ignore" },
    "bounty_rune": { "files": ["builtin:bounty_rune"], "bus": "monitor", "mode": "ignore" },
    "rosh":        { "files": ["builtin:rosh"], "bus": "monitor" },
    "low_hp":      { "files": ["builtin:danger"], "bus": "monitor", "cooldown": 8 }
  },

  "hotkeys": {
    "Num2":   "sound:wisdom_rune@both",
    "Num3":   "sound:mid_rune_6@both",
    "Num0":   "preset:clean",
    "Num4":   "preset:dead_inside",
    "Num5":   "preset:dead_inside_max",
    "Num6":   "preset:radio",
    "Num7":   "preset:radio_broken",
    "Num8":   "preset:megaphone",
    "Num9":   "preset:robot",
    "NumAdd": "preset:next",
    "NumSub": "rosh",
    "NumMul": "mic_monitor",
    "NumDot": "stop",
    "NumDiv": "reload",
    "Ctrl+Alt+V": "ui"
  },

  "timers": [
    { "id": "mid_rune_6",  "label": "Руна в миду 6:00", "sound": "mid_rune_6",  "at": [360], "warn_before": 10 },
    { "id": "wisdom_rune", "label": "Руна мудрости", "sound": "wisdom_rune", "start": 420, "every": 420, "warn_before": 20 },
    { "id": "power_rune",  "label": "Руна силы", "sound": "power_rune",  "start": 360, "every": 120, "skip": [360], "warn_before": 10, "disabled": true },
    { "id": "bounty_rune", "label": "Руна богатства", "sound": "bounty_rune", "start": 180, "every": 180, "warn_before": 10, "disabled": true },
    { "id": "stack",       "label": "Стак крипов", "sound": "stack@monitor", "start": 50, "every": 60, "until": 1200, "disabled": true }
  ],

  "rosh": {
    "sound": "rosh",
    "aegis_warn": 30,
    "min_warn": 30
  },

  "events": {
    "low_hp": "low_hp"
  },

  "gsi": {
    "enabled": true,
    "addr": "127.0.0.1:3000",
    "token": "voicebox",
    "low_hp_percent": 25
  },

  "voice_presets": {},

  "scripts": {
    "gank_mid": true
  },

  "ui": {
    "port": 3001,
    "keep_running_on_close": false,
    "open_on_start": true
  },
  "setup_done": false,

  "mic": { "mute": false, "gate_db": 0 },
  "sources": [],
  "update": { "auto_check": true, "auto_install": true }
}
