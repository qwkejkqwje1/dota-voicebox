{
  "version": 3,
  "devices": {
    "mic": "",
    "voice_out": "",
    "monitor": ""
  },
  "mic_gain": 1.0,
  "ducking": 0.35,
  "fx_on_sounds": false,
  "monitor_volume": 0.8,
  "sfx_volume": 1.0,
  "normalize_sounds": true,

  "ptt": {
    "key": "",
    "auto": true,
    "auto_detect": true,
    "lead_ms": 120,
    "tail_ms": 200
  },

  "talk": {
    "mode": "always",
    "key": "",
    "release_ms": 150,
    "press_game_key": true
  },

  "start_preset": "clean",
  "preset_params": {},
  "sounds_dir": "sounds",
  "tts_rate": 1,

  "sounds": {
    "airhorn":      { "label": "Дудка", "emoji": "📯", "color": "#f59e0b", "files": ["builtin:airhorn"], "mode": "toggle" },
    "sad_trombone": { "label": "Грустный тромбон", "emoji": "🎺", "color": "#60a5fa", "files": ["builtin:sad_trombone"], "mode": "toggle" },
    "rimshot":      { "label": "Ба-дум-тсс", "emoji": "🥁", "color": "#a78bfa", "files": ["builtin:rimshot"], "mode": "toggle" },
    "drumroll":     { "label": "Барабанная дробь", "emoji": "🪘", "color": "#fb923c", "files": ["builtin:drumroll"], "mode": "toggle" },
    "crickets":     { "label": "Сверчки", "emoji": "🦗", "color": "#34d399", "files": ["builtin:crickets"], "mode": "toggle" },
    "ding":         { "label": "Правильно!", "emoji": "✅", "color": "#22c55e", "files": ["builtin:ding"], "mode": "toggle" },
    "buzzer":       { "label": "Неправильно!", "emoji": "❌", "color": "#ef4444", "files": ["builtin:buzzer"], "mode": "toggle" },
    "laser":        { "label": "Пиу-пиу", "emoji": "🔫", "color": "#22d3ee", "files": ["builtin:laser"], "mode": "overlap" },
    "boing":        { "label": "Боинг", "emoji": "🌀", "color": "#f472b6", "files": ["builtin:boing"], "mode": "overlap" },

    "dota_gank":  { "label": "Ганк на миде!", "emoji": "🚨", "color": "#ef4444", "category": "Dota 2", "dota": true,
                    "files": ["builtin:alert", "tts:Мид, ганк!"], "seq": true, "mode": "interrupt", "cooldown": 2 },
    "dota_mia":   { "label": "Мид пропал", "emoji": "❓", "color": "#f59e0b", "category": "Dota 2", "dota": true,
                    "files": ["builtin:beep2", "tts:Мид пропал!"], "seq": true, "mode": "interrupt", "cooldown": 2 },
    "dota_smoke": { "label": "Смоук!", "emoji": "🌫️", "color": "#94a3b8", "category": "Dota 2", "dota": true,
                    "files": ["builtin:beep2", "tts:Осторожно, смоук!"], "seq": true, "mode": "interrupt", "cooldown": 2 },
    "dota_rosh":  { "label": "На Рошана", "emoji": "🐲", "color": "#a78bfa", "category": "Dota 2", "dota": true,
                    "files": ["tts:Идём на Рошана!"], "mode": "interrupt", "cooldown": 2 },
    "dota_def":   { "label": "Все на деф", "emoji": "🛡️", "color": "#60a5fa", "category": "Dota 2", "dota": true,
                    "files": ["builtin:beep2", "tts:Все на деф!"], "seq": true, "mode": "interrupt", "cooldown": 2 },
    "low_hp":     { "files": ["builtin:danger"], "bus": "monitor", "cooldown": 8, "dota": true, "hidden": true }
  },
  "pad": ["airhorn", "sad_trombone", "rimshot", "drumroll", "crickets", "ding", "buzzer", "laser", "boing",
          "dota_gank", "dota_mia", "dota_smoke", "dota_rosh", "dota_def"],

  "hotkeys": {
    "Alt+TILDE": "menu",
    "Pause": "stop",
    "Ctrl+Alt+V": "ui",
    "Num1": "sound:dota_gank",
    "Ctrl+Num1": "sound:dota_mia"
  },

  "quick_menu": {
    "enabled": true,
    "items": [],
    "effects": [],
    "layout": "list",
    "position": "center",
    "x": 0.5,
    "y": 0,
    "monitor": "game",
    "opacity": 0.95,
    "close_after_pick": true,
    "timeout_sec": 8,
    "show_effects": true,
    "scale": 1
  },

  "wheel": {
    "enabled": false,
    "items": [],
    "center": "cursor",
    "scale": 1,
    "opacity": 0.92
  },

  "remote": {
    "enabled": false,
    "port": 0,
    "key": "",
    "sounds": "pad",
    "show_effects": true,
    "show_mic": true
  },

  "dota": {
    "enabled": false,
    "voice_to": "monitor",
    "volume": 1,
    "rosh": true,
    "reminders": [
      { "id": "wisdom", "label": "Руна мудрости", "enabled": true, "start": 420, "every": 420, "before": 20 },
      { "id": "power",  "label": "Руны силы", "enabled": true, "at": [360], "before": 10 },
      { "id": "support_runes", "label": "Саппорты к рунам", "enabled": true, "at": [360], "before": 40, "to": "both",
        "say": "Саппорты, руны силы {время}. Перетянитесь и подконтрольте руны" },
      { "id": "water",  "label": "Водная руна", "enabled": false, "at": [120, 240], "before": 10 },
      { "id": "bounty", "label": "Руны богатства", "enabled": false, "start": 180, "every": 180, "before": 10 },
      { "id": "lotus",  "label": "Лотосы", "enabled": false, "start": 180, "every": 180, "until": 540, "before": 10 },
      { "id": "stack",  "label": "Стак крипов", "enabled": false, "start": 60, "every": 60, "until": 1200, "before": 7, "say": "Стак" }
    ]
  },

  "rosh": {
    "aegis_warn": 30,
    "min_warn": 30
  },

  "events": {
    "low_hp": "low_hp"
  },

  "gsi": {
    "enabled": true,
    "addr": "127.0.0.1:3000",
    "token": "voicebox",
    "low_hp_percent": 25
  },

  "voice_presets": {},

  "scripts": {
    "gank_mid": false
  },

  "ui": {
    "port": 3001,
    "keep_running_on_close": true,
    "open_on_start": true
  },
  "setup_done": false,

  "mic": { "mute": false, "gate_db": 0, "denoise": true, "denoise_level": 0.92, "timbre": "", "smooth": 0.4 },
  "background": { "id": "", "volume": 0.3, "only_talking": true },
  "auto_set": true,
  "sources": [],
  "update": { "auto_check": true, "auto_install": true }
}
